FROM python:3.10-slim
WORKDIR /app
# Install python packages (no PyTorch: models run on ONNX Runtime).
COPY requirements.txt /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt
# Copy the application code, then download the models into the image so the
# container starts without fetching them.
COPY . /app
RUN python -m app.download_models
EXPOSE 8000
CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000"]
