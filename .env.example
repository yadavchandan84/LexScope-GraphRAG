QDRANT_URL=https://xxxxx.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password
NEO4J_DATABASE=neo4j
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-flash-lite

# --- Caching (optional but recommended for fast repeat / golden-set answers) ---
# Set REDIS_URL to enable a shared, persistent cache. If unset, the app falls
# back to an in-process cache automatically (no extra infra required).
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_ANSWER_TTL=604800
CACHE_EMBEDDING_TTL=2592000

# --- Timeouts (seconds) ---
GEMINI_TIMEOUT=60
NEO4J_TIMEOUT=15

# --- Models (ONNX Runtime via fastembed, no PyTorch) ---
# Changing EMBEDDING_MODEL requires re-indexing the corpus, and EMBEDDING_DIM
# must match the model's output dimension.
#   BAAI/bge-small-en-v1.5 -> EMBEDDING_DIM=384  (default, fits Render free plan)
#   BAAI/bge-base-en-v1.5  -> EMBEDDING_DIM=768  (better quality, needs more RAM)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# ONNX cross-encoder reranker (~23 MB quantized).
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
# ONNX threads for embeddings: leave empty locally (all cores), 1 on small hosts.
ONNX_THREADS=
MODEL_CACHE_DIR=models_cache
